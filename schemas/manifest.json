{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Victhors/llm-conductor/schemas/manifest.json",
  "title": "conductor run manifest",
  "description": "Single source of truth for a pipeline run. Versioned MAJOR.MINOR; additive changes bump MINOR and apply defaults on read, breaking changes bump MAJOR and require a migrator.",
  "type": "object",
  "required": ["schema_version", "run_id", "stages"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "goal": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "active": { "type": "boolean" },
    "tokens_consumed_estimate": { "type": "integer", "minimum": 0 },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "enum": ["pending", "running", "done", "failed", "skipped", "aborted"] },
          "gate": { "enum": ["pass", "warn", "fail"] }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "by", "result", "ts"],
        "properties": {
          "stage": { "type": "string" },
          "by": { "type": "string" },
          "result": { "type": "string" },
          "rationale": { "type": "string" },
          "ts": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
